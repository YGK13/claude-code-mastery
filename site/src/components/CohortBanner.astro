---
/**
 * CohortBanner.astro
 * Top-of-page banner for the founding CAIO cohort.
 * Executive Premium brand: deep ink with oxblood→gold depth, gold pill + CTA.
 */
---

<aside class="cohort-banner" aria-label="Cohort enrollment">
  <div class="cohort-banner__inner">
    <span class="cohort-banner__pill">Founding Cohort · Now enrolling</span>
    <span class="cohort-banner__copy">
      The Chief AI Officer Program — 12-week live cohort with Yuri. Founding price <strong>$2,500</strong> (cohort #2 rises to $4,500).
    </span>
    <a
      class="cohort-banner__cta"
      href="https://forwardshare.co/executive-ai-cohort-forward-achieve-forward-share-ventures"
      target="_blank"
      rel="noopener"
    >
      Apply now →
    </a>
    <a
      class="cohort-banner__secondary"
      href="https://calendly.com/masterthetalk/call-with-yuri-30-min?back=1"
      target="_blank"
      rel="noopener"
    >
      Book a 15-min call
    </a>
  </div>
</aside>

<style>
  .cohort-banner {
    background:
      linear-gradient(135deg, #5e1f26 0%, #3a1b22 45%, #11151f 100%);
    color: #f4f1e9;
    border-bottom: 1px solid rgba(201, 162, 75, 0.28);
    box-shadow: 0 1px 0 rgba(201, 162, 75, 0.12) inset;
    position: relative;
    overflow: hidden;
  }
  .cohort-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 120% at 12% 0%, rgba(201, 162, 75, 0.16), transparent 70%);
    pointer-events: none;
  }
  .cohort-banner__inner {
    position: relative;
    max-width: 90rem;
    margin: 0 auto;
    padding: 0.8rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.92rem;
  }
  .cohort-banner__pill {
    background: linear-gradient(180deg, #e2c079, #c9a24b);
    color: #1a1306;
    padding: 0.32rem 0.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: 'Inter', sans-serif;
    box-shadow: 0 2px 8px -2px rgba(201, 162, 75, 0.5);
    white-space: nowrap;
  }
  .cohort-banner__copy {
    color: rgba(244, 241, 233, 0.94);
    flex: 1 1 auto;
    min-width: 14rem;
    line-height: 1.4;
  }
  .cohort-banner__copy strong { color: #e2c079; font-weight: 700; }
  .cohort-banner__cta {
    background: linear-gradient(180deg, #e2c079, #c9a24b);
    color: #1a1306;
    padding: 0.55rem 1.15rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
    box-shadow: 0 4px 14px -4px rgba(201, 162, 75, 0.5);
  }
  .cohort-banner__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px -4px rgba(201, 162, 75, 0.6);
    color: #1a1306;
  }
  .cohort-banner__secondary {
    color: rgba(244, 241, 233, 0.9);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(201, 162, 75, 0.5);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition: text-decoration-color 0.15s ease, color 0.15s ease;
  }
  .cohort-banner__secondary:hover { color: #e2c079; text-decoration-color: #c9a24b; }
  @media (max-width: 768px) {
    .cohort-banner__inner { gap: 0.65rem; padding: 0.7rem 1rem; }
    .cohort-banner__copy { font-size: 0.85rem; width: 100%; order: 2; }
    .cohort-banner__pill { order: 1; }
    .cohort-banner__cta { order: 3; flex: 1; text-align: center; }
    .cohort-banner__secondary { display: none; }
  }
</style>
