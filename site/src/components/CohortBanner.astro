---
/**
 * CohortBanner.astro
 * Top-of-page banner for the ForwardShare founding cohort.
 *
 * Brand-matched to portlev.com:
 *   - Vibrant indigo gradient (#4b41e1 → #645efb → #818cf8) — same as portlev.com primary CTA
 *   - Amber pill (#f59e0b) as the attention-grabbing accent
 *   - Heavy indigo-colored shadow for the lift effect
 *   - White text with high contrast on the indigo bg — readable in both light AND dark mode
 */
---

<aside class="cohort-banner" aria-label="Cohort enrollment">
  <div class="cohort-banner__inner">
    <span class="cohort-banner__pill">Founding Cohort · 4 / 8 spots left</span>
    <span class="cohort-banner__copy">
      3-month live program with Yuri — <strong>$2,500</strong> (next cohort $4,500)
    </span>
    <a
      class="cohort-banner__cta"
      href="https://forwardshare.co/executive-ai-cohort-forward-achieve-forward-share-ventures"
      target="_blank"
      rel="noopener"
    >
      Apply now →
    </a>
    <a
      class="cohort-banner__secondary"
      href="https://calendly.com/masterthetalk/call-with-yuri-30-min?back=1"
      target="_blank"
      rel="noopener"
    >
      Book a 15-min call
    </a>
  </div>
</aside>

<style>
  .cohort-banner {
    /* Vibrant indigo gradient — same family as portlev.com primary CTA buttons.
       Strong contrast against both light (#f7f9fb) and dark (#000613) page bgs. */
    background:
      linear-gradient(135deg, #4b41e1 0%, #5b51e9 35%, #645efb 65%, #818cf8 100%);
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.1) inset,
      0 8px 24px -10px rgba(75, 65, 225, 0.6);
    position: relative;
    overflow: hidden;
  }

  /* Subtle radial highlight in the upper-left for depth */
  .cohort-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 100% at 20% 0%, rgba(255, 255, 255, 0.18), transparent 70%);
    pointer-events: none;
  }

  .cohort-banner__inner {
    position: relative;
    max-width: 90rem;
    margin: 0 auto;
    padding: 0.8rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.92rem;
  }

  .cohort-banner__pill {
    background: linear-gradient(180deg, #fbbf24, #f59e0b);
    color: #1c1410;
    padding: 0.32rem 0.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: 'Manrope', sans-serif;
    box-shadow: 0 2px 8px -2px rgba(245, 158, 11, 0.5);
    white-space: nowrap;
  }

  .cohort-banner__copy {
    color: rgba(255, 255, 255, 0.94);
    flex: 1 1 auto;
    min-width: 14rem;
    line-height: 1.4;
  }

  .cohort-banner__copy strong {
    color: #ffffff;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.12);
    padding: 0.05em 0.4em;
    border-radius: 4px;
  }

  .cohort-banner__cta {
    background: #ffffff;
    color: #2e26a6;
    padding: 0.55rem 1.15rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.06) inset,
      0 4px 14px -4px rgba(0, 0, 0, 0.25);
  }
  .cohort-banner__cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.06) inset,
      0 8px 20px -4px rgba(0, 0, 0, 0.35);
    color: #2e26a6;
  }

  .cohort-banner__secondary {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition: text-decoration-color 0.15s ease;
  }
  .cohort-banner__secondary:hover {
    color: #ffffff;
    text-decoration-color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 768px) {
    .cohort-banner__inner {
      gap: 0.65rem;
      padding: 0.7rem 1rem;
    }
    .cohort-banner__copy {
      font-size: 0.85rem;
      width: 100%;
      order: 2;
    }
    .cohort-banner__pill {
      order: 1;
    }
    .cohort-banner__cta {
      order: 3;
      flex: 1;
      text-align: center;
    }
    .cohort-banner__secondary {
      display: none;
    }
  }
</style>
