---
// CaioDiagnostic.astro — the 12-competency CAIO Readiness Diagnostic.
// Imported by /program/pillar-1-mandate/readiness-diagnostic.mdx.
---

<div id="caio-diagnostic" class="pl-diagnostic">

  <div class="pl-d-section">Leadership &amp; business — the 80% you likely already hold</div>
  <p class="pl-d-section-help">Rate yourself 1 (no real exposure) to 5 (done it repeatedly at senior level).</p>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">1.</span>Executive influence<span class="pl-d-q-desc">Persuading a board or C-suite to back a direction; trusted to lead it.</span></div><div class="pl-d-scale" data-q="1"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">2.</span>P&amp;L and capital allocation<span class="pl-d-q-desc">Owning a budget, prioritizing bets, killing what doesn't pay off.</span></div><div class="pl-d-scale" data-q="2"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">3.</span>Change management<span class="pl-d-q-desc">Moving a skeptical organization to adopt a new way of working.</span></div><div class="pl-d-scale" data-q="3"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">4.</span>Cross-functional translation<span class="pl-d-q-desc">Making one function understood by another; brokering between them.</span></div><div class="pl-d-scale" data-q="4"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">5.</span>Team building<span class="pl-d-q-desc">Hiring, structuring and leading a function.</span></div><div class="pl-d-scale" data-q="5"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">6.</span>Risk and stakeholder judgment<span class="pl-d-q-desc">Reading political, legal and reputational risk; navigating it.</span></div><div class="pl-d-scale" data-q="6"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-section">AI-specific — the 20% this program closes</div>
  <p class="pl-d-section-help">Same scale. Be a tough grader; this is your punch list.</p>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">7.</span>AI fluency<span class="pl-d-q-desc">Explaining how modern models, agents and retrieval work, well enough to defend a roadmap to a board.</span></div><div class="pl-d-scale" data-q="7"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">8.</span>Build-vs-buy and vendor judgment<span class="pl-d-q-desc">Evaluating AI tools, platforms and vendors on cost, risk and fit.</span></div><div class="pl-d-scale" data-q="8"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">9.</span>AI governance<span class="pl-d-q-desc">Policy, review, governance committee, aligned to EU AI Act &amp; NIST.</span></div><div class="pl-d-scale" data-q="9"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">10.</span>AI value and ROI<span class="pl-d-q-desc">Building the funding case and the system that tracks whether AI is actually paying off.</span></div><div class="pl-d-scale" data-q="10"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">11.</span>Adoption design<span class="pl-d-q-desc">The literacy and behavior-change program that gets real usage, not just access.</span></div><div class="pl-d-scale" data-q="11"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-row"><div class="pl-d-q"><span class="pl-d-q-num">12.</span>Proof you can ship<span class="pl-d-q-desc">You have personally built or deployed a working AI tool, not just commissioned one.</span></div><div class="pl-d-scale" data-q="12"><button data-v="1">1</button><button data-v="2">2</button><button data-v="3">3</button><button data-v="4">4</button><button data-v="5">5</button></div></div>

  <div class="pl-d-submit">
    <button type="button" id="caio-d-go">See my CAIO Readiness Score →</button>
    <span class="pl-d-progress" id="caio-d-progress">0 of 12 answered</span>
  </div>

  <div class="pl-d-result" id="caio-d-result" role="status" aria-live="polite">
    <h3 id="caio-d-headline">Your CAIO Readiness</h3>
    <div class="pl-d-scores">
      <div class="pl-d-score"><div class="pl-d-score-label">Overall</div><div class="pl-d-score-value" id="caio-d-overall">—</div></div>
      <div class="pl-d-score"><div class="pl-d-score-label">Leadership</div><div class="pl-d-score-value" id="caio-d-lead">—</div></div>
      <div class="pl-d-score"><div class="pl-d-score-label">AI-specific</div><div class="pl-d-score-value" id="caio-d-ai">—</div></div>
    </div>
    <p id="caio-d-narrative"></p>
    <p style="margin-bottom:0.3rem;color:var(--pl-gold-bright);font-weight:600;">Your two biggest gaps:</p>
    <ul class="pl-d-gap-list" id="caio-d-gaps"></ul>
    <p id="caio-d-prescription"></p>
    <form class="pl-d-waitlist" action="mailto:hello@portlev.com?subject=CAIO%20Readiness%20Score" method="POST" enctype="text/plain" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:1.4rem 0 1.2rem;">
      <input type="email" name="email" required placeholder="email me my CAIO report" aria-label="Email" style="flex:1 1 260px;min-width:0;padding:0.8rem 1rem;border-radius:11px;border:1px solid var(--sl-color-hairline);background:var(--sl-color-bg-nav);color:var(--sl-color-text);font:inherit;font-size:0.95rem;" />
      <button type="submit" style="background:linear-gradient(180deg,var(--pl-gold-bright),var(--pl-gold));color:#1a1306;border:none;font-weight:700;padding:0.8rem 1.3rem;border-radius:11px;cursor:pointer;font-family:var(--sl-font);">Send me my report</button>
    </form>
    <p style="font-size:0.84rem;color:var(--sl-color-gray-3);margin:0 0 1rem;">We&rsquo;ll send your score, gap profile and the recommended path — plus early access when the certificate opens.</p>
    <a class="pl-d-cta" href="/program/the-program/">Close the gap — see the program →</a>
    <a href="https://calendly.com/masterthetalk/call-with-yuri-30-min?back=1" style="color:var(--pl-gold-bright); margin-left:0.8rem;">or book a 15-min call with Yuri</a>
  </div>

</div>

<script is:inline>
(function(){
  var root = document.getElementById('caio-diagnostic');
  if (!root) return;
  var answers = {};
  var COMPETENCIES = [
    'Executive influence','P&L and capital allocation','Change management','Cross-functional translation',
    'Team building','Risk and stakeholder judgment','AI fluency','Build-vs-buy and vendor judgment',
    'AI governance','AI value and ROI','Adoption design','Proof you can ship'
  ];
  var ARCHETYPES = {
    'Strategist': { qs:[1,2], desc:'You lead with prioritization, capital and executive persuasion. Your CAIO position is the bet-allocator and CEO partner.' },
    'Governor':   { qs:[6,9], desc:'You lead with risk, governance and the board’s first question. Your CAIO position becomes mandatory as the EU AI Act and proxy expectations land in 2026.' },
    'Transformer':{ qs:[3,5,11], desc:'You lead with people, change and adoption — exactly where 95% of AI initiatives fail. Your CAIO position owns the human side of the convergence.' },
    'Platform Builder': { qs:[7,8,12], desc:'You skew technical relative to the typical executive buyer. Your CAIO position leads the platform and the engineering org; round out governance and value to be undeniable.' },
    'Commercializer': { qs:[4,10], desc:'You lead with cross-functional translation and value creation. Your CAIO position turns AI capability into customer-facing offerings and revenue.' }
  };
  function progress(){
    var n = Object.keys(answers).length;
    document.getElementById('caio-d-progress').textContent = n + ' of 12 answered';
  }
  root.querySelectorAll('.pl-d-scale').forEach(function(scale){
    var q = parseInt(scale.getAttribute('data-q'),10);
    scale.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){
        var v = parseInt(b.getAttribute('data-v'),10);
        answers[q] = v;
        scale.querySelectorAll('button').forEach(function(x){ x.setAttribute('aria-pressed', x===b ? 'true' : 'false'); });
        progress();
        try { localStorage.setItem('caio-d-answers', JSON.stringify(answers)); } catch(e){}
      });
    });
  });
  try {
    var saved = JSON.parse(localStorage.getItem('caio-d-answers') || '{}');
    Object.keys(saved).forEach(function(k){
      var v = saved[k];
      var scale = root.querySelector('.pl-d-scale[data-q="'+k+'"]');
      if (!scale) return;
      var btn = scale.querySelector('button[data-v="'+v+'"]');
      if (btn) { btn.setAttribute('aria-pressed','true'); answers[parseInt(k,10)] = v; }
    });
    progress();
  } catch(e){}

  document.getElementById('caio-d-go').addEventListener('click', function(){
    var ids = Object.keys(answers).map(function(k){ return parseInt(k,10); });
    if (ids.length < 12) {
      var btn = document.getElementById('caio-d-go');
      var prev = btn.textContent;
      btn.textContent = 'Answer all 12 to see your score';
      setTimeout(function(){ btn.textContent = prev; }, 2000);
      return;
    }
    var lead = [1,2,3,4,5,6].reduce(function(a,q){ return a+answers[q]; },0);
    var ai   = [7,8,9,10,11,12].reduce(function(a,q){ return a+answers[q]; },0);
    var leadPct = Math.round(lead/30*100);
    var aiPct = Math.round(ai/30*100);
    var overallPct = Math.round((lead+ai)/60*100);

    var best=null, bestScore=-1;
    Object.keys(ARCHETYPES).forEach(function(name){
      var qs = ARCHETYPES[name].qs;
      var s = qs.reduce(function(a,q){ return a+answers[q]; },0)/qs.length;
      if (s>bestScore) { bestScore=s; best=name; }
    });

    var ranked = Object.keys(answers).map(function(k){ return {q:parseInt(k,10), v:answers[k]}; });
    ranked.sort(function(a,b){ return a.v-b.v; });
    var gaps = ranked.slice(0,2);

    document.getElementById('caio-d-overall').textContent = overallPct + '%';
    document.getElementById('caio-d-lead').textContent = leadPct + '%';
    document.getElementById('caio-d-ai').textContent = aiPct + '%';

    var profileLabel = leadPct >= 70 && aiPct < 60
      ? 'classic executive pivoter — strong leadership baseline, specific AI gap to close.'
      : leadPct >= 70 && aiPct >= 60
        ? 'near-ready — you are closer than you think; the program closes specific gaps fast.'
        : aiPct >= leadPct
          ? 'technical-leaning candidate — the program rounds out the executive and governance layer.'
          : 'early-stage build — the program is the structured 12-month path to ready.';
    document.getElementById('caio-d-narrative').innerHTML =
      'You scored <strong>' + overallPct + '%</strong> overall. Your leadership baseline (the 80% you likely already hold) is <strong>' + leadPct + '%</strong>; your AI-specific layer (the 20% the program closes) is <strong>' + aiPct + '%</strong>. Profile: ' + profileLabel +
      ' Your archetype fit looks like <strong>' + best + '</strong>. ' + ARCHETYPES[best].desc;

    var gapList = document.getElementById('caio-d-gaps');
    gapList.innerHTML = '';
    gaps.forEach(function(g){
      var li = document.createElement('li');
      li.textContent = COMPETENCIES[g.q-1] + ' (you scored ' + g.v + '/5)';
      gapList.appendChild(li);
    });
    var prescription = '';
    if (gaps.some(function(g){ return g.q===9; })) prescription += 'Pillar IV (Governance) is your fastest unlock. ';
    if (gaps.some(function(g){ return g.q===10; })) prescription += 'Pillar V (Value & Adoption) gives you the ROI model. ';
    if (gaps.some(function(g){ return g.q===12; })) prescription += 'Pillar III (Build) gives you the portfolio proof that closes the biggest gap most candidates have. ';
    if (gaps.some(function(g){ return g.q===7 || g.q===8; })) prescription += 'Pillar II (Fluency) gets you to "lead and defend" depth. ';
    if (!prescription) prescription = 'The full program addresses your remaining gaps directly. ';
    document.getElementById('caio-d-prescription').innerHTML = prescription + 'A re-scored diagnostic at the end of the program shows your delta.';

    var result = document.getElementById('caio-d-result');
    result.classList.add('show');
    try { result.scrollIntoView({behavior:'smooth', block:'start'}); } catch(e){}
    try { localStorage.setItem('caio-d-result', JSON.stringify({overallPct:overallPct, leadPct:leadPct, aiPct:aiPct, best:best})); } catch(e){}
  });
})();
</script>
